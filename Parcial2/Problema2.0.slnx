#include <iostream>
#include <string>
using namespace std;

struct Producto {
    string nombre;
    double precio;
    int cantidad;
};

int main() {

    Producto productos[5];

    double mayorValor = 0;
    int posicion = 0;

    // Capturar productos
    for (int i = 0; i < 5; i++) {

        cout << "\nProducto " << i + 1 << endl;

        cout << "Nombre: ";
        cin >> productos[i].nombre;

        cout << "Precio: ";
        cin >> productos[i].precio;

        cout << "Cantidad: ";
        cin >> productos[i].cantidad;

        double valor = productos[i].precio *
            productos[i].cantidad;

        if (valor > mayorValor) {
            mayorValor = valor;
            posicion = i;
        }
    }

    // Mostrar producto de mayor valor
    cout << "\nProducto con mayor valor "
        << "en inventario: "
        << productos[posicion].nombre;

    cout << "\nValor total: " << mayorValor;

    return 0;
}
