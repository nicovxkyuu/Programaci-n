#include <iostream>
#include <fstream>
#include <string>
using namespace std;

struct Alumno {
    string nombre, matricula;
    float calif[3];
    int grupo;
};

int main() {
    Alumno a;

    cout << "Nombre: ";
    getline(cin, a.nombre);

    cout << "Matricula: ";
    getline(cin, a.matricula);

    for (int i = 0; i < 3; i++) {
        cout << "Calificacion: ";
        cin >> a.calif[i];
    }

    cout << "Grupo: ";
    cin >> a.grupo;

    ofstream archivo("alumnos.txt", ios::app);

    if (!archivo) {
        cout << "Error al abrir archivo.";
        return 0;
    }

    archivo << a.nombre << "|"
        << a.matricula << "|"
        << a.calif[0] << "|"
        << a.calif[1] << "|"
        << a.calif[2] << "|"
        << a.grupo << endl;

    archivo.close();

    cout << "Nuevo alumno agregado.";

    return 0;
}
