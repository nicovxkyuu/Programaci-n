#include <iostream>
#include <fstream>
#include <string>
#include <sstream>
using namespace std;

struct Alumno {
    string nombre, matricula;
    float calif[3];
    int grupo;
};

int main() {
    Alumno alumnos[100];
    string linea, dato;
    int n = 0;

    ifstream archivo("alumnos.txt");

    if (!archivo.is_open()) {
        cout << "No se pudo abrir el archivo.";
        return 0;
    }

    while (getline(archivo, linea) && n < 100) {
        stringstream s(linea);

        if (!getline(s, alumnos[n].nombre, '|')) continue;
        if (!getline(s, alumnos[n].matricula, '|')) continue;

        try {
            for (int j = 0; j < 3; j++) {
                if (!getline(s, dato, '|'))
                    throw 1;

                alumnos[n].calif[j] = stof(dato);
            }

            if (!getline(s, dato, '|'))
                throw 1;

            alumnos[n].grupo = stoi(dato);
        }
        catch (...) {
            cout << "\nError al leer un alumno.";
            continue;
        }

        n++;
    }

    archivo.close();

    cout << "\nALUMNOS RECUPERADOS\n";

    for (int i = 0; i < n; i++) {
        cout << "\nNombre: " << alumnos[i].nombre;
        cout << "\nMatricula: " << alumnos[i].matricula;
        cout << "\nCalificaciones: "
            << alumnos[i].calif[0] << ", "
            << alumnos[i].calif[1] << ", "
            << alumnos[i].calif[2];
        cout << "\nGrupo: " << alumnos[i].grupo;
        cout << "\n----------------------";
    }

    cout << "\nTotal de alumnos: " << n;

    return 0;
}
